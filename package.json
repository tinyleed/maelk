{
  "name": "maelk",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/app"
  ],
  "overrides": {
    "@vercel/static-config": {
      "ajv": "^8.18.0"
    }
  },
  "scripts": {
    "dev": "npm --workspace @maelk/app run dev",
    "build": "npm --workspace @maelk/app run build",
