# Server-only auth configuration. Never expose these values through VITE_* variables.
NODE_ENV=development
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-project-anon-key
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ALGORITHMS=RS256,ES256
MAELK_AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
MAELK_SESSION_ENCRYPTION_KEY=replace-with-32-random-base64url-bytes
DATABASE_URL=postgresql://replace-with-local-or-supabase-connection